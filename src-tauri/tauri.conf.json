{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laboratorio EM",
  "version": "0.1.0",
  "identifier": "edu.laboratorioem.simulador",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Laboratorio EM — Simulador de Física",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": { "active": true, "targets": "all" }
}
